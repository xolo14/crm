# DECOY Layer 1 — Neon PostgreSQL (separate from Syncpedia Hostinger MySQL)

# Preferred: Neon Console → Connection details → URI
DECOY_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Or discrete fields (if not using DECOY_DATABASE_URL):
# DECOY_DB_HOST=ep-xxxx.REGION.aws.neon.tech
# DECOY_DB_PORT=5432
# DECOY_DB_NAME=neondb
# DECOY_DB_USER=neondb_owner
# DECOY_DB_PASS=
# DECOY_DB_SSLMODE=require

# openssl rand -hex 32 — MUST differ from production JWT_SECRET
DECOY_JWT_SECRET=

DECOY_ALERT_WEBHOOK_URL=
DECOY_FRONTEND_PATH=/legacy
DECOY_COOKIE_NAME=syncpedia_decoy_session
